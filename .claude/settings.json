{
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push:*)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_force_push.py\"",
            "statusMessage": "force push 여부 확인 중"
          }
        ]
      }
    ]
  }
}
